DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
REDIS_URL="redis://redis:6379"
MASTER_HUB_STORAGE_DIR="/data/masterhub-storage"
PRINT_OUTBOX_DIR="/data/masterhub-outbox/print"
FAX_OUTBOX_DIR="/data/masterhub-outbox/fax"
# 共有フォルダ(作業表☆/作業伝票)の自動同期用。
# 本番PCが共有フォルダのホストPCと同一の場合、ネットワーク越しのCIFSマウントは不要で、
# Docker Desktopのbind mountでホスト側ローカルパスを直接コンテナへ渡せる。
# SHARED_SOURCE_HOST_PATH は docker-compose.prod.yml 側のホストパス(Windowsのローカルパス、例: C:/Shared/共有フォルダ)。
# 末尾は docker-compose.prod.yml の volumes 定義と合わせて container 側 /shared-source にマウントされる。
SHARED_SOURCE_HOST_PATH="C:/path/to/共有フォルダ"
MASTER_HUB_SHARED_SOURCE_DIR="/shared-source"
NEXTAUTH_SECRET="replace-with-a-strong-random-string"
NEXTAUTH_URL="https://your-domain.example.com"
ADMIN_TOKEN=""
DESKTOP_APP_VERSION="0.1.3"
DESKTOP_APP_DOWNLOAD_URL="https://your-domain.example.com/downloads/Master-Hub-Setup-0.1.3.exe"
DESKTOP_APP_RELEASE_NOTES=""
DESKTOP_APP_PUBLISHED_AT=""
DESKTOP_APP_CHANNEL="stable"