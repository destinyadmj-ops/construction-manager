generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id @default(cuid())
  email                String?              @unique
  name                 String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  canEditSchedule      Boolean              @default(false)
  kind                 UserKind             @default(NORMAL)
  canGrantScheduleEdit Boolean              @default(false)
  calendarEvents       CalendarEvent[]
  integrations         IntegrationAccount[]
  siteMemberships      SiteMember[]
  timeClocks           TimeClock[]
  uiSettings           UserUiSetting[]
  workEntries          WorkEntry[]
}

model UserUiSetting {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, key])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  title       String
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean  @default(false)
  description String?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
}

model WorkEntry {
  id             String          @id @default(cuid())
  userId         String
  startAt        DateTime
  endAt          DateTime?
  note           String?
  relatedEventId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accountingMeta Json?
  accountingType AccountingType?
  amount         Decimal?
  department     String?
  summary        String?
  taxCategory    String?
  siteId         String?
  kind           WorkEntryKind   @default(NORMAL)
  site           Site?           @relation(fields: [siteId], references: [id])
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
  @@index([siteId, startAt])
}

model Site {
  id                    String           @id @default(cuid())
  companyName           String?
  name                  String
  address               String?
  phone                 String?
  contactName           String?
  notes                 String?
  repeatRule            Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  depreciationThreshold Int              @default(10)
  alertsEnabled         Boolean          @default(true)
  amount                Decimal?
  caution               String?
  defaultWorkMinutes    Int?
  detail                String?
  kind                  SiteKind         @default(NORMAL)
  pace                  String?
  peopleCount           Int?
  scheduleLabelColor    String           @default("default")
  outlookSendLogs       OutlookSendLog[]
  members               SiteMember[]
  storedDocuments       StoredDocument[]
  timeClocks            TimeClock[]
  workEntries           WorkEntry[]

  @@index([name])
  @@index([companyName, name])
}

model SiteMember {
  id        String   @id @default(cuid())
  siteId    String
  userId    String
  createdAt DateTime @default(now())
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, userId])
  @@index([siteId])
  @@index([userId])
}

model TimeClock {
  id        String    @id @default(cuid())
  userId    String
  siteId    String?
  inAt      DateTime
  outAt     DateTime?
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  site      Site?     @relation(fields: [siteId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, inAt])
  @@index([siteId, inAt])
  @@index([userId, outAt])
}

model IntegrationAccount {
  id          String              @id @default(cuid())
  userId      String
  provider    IntegrationProvider
  status      IntegrationStatus   @default(ACTIVE)
  displayName String?
  credentials Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
}

model AccountingExportPreset {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String?
  body      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Partner {
  id                           String           @id @default(cuid())
  name                         String           @unique
  email                        String?
  notes                        String?
  outlookToEmailDefault        String?
  outlookSubjectReportDefault  String?
  outlookSubjectInvoiceDefault String?
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt
  fax                          String?
  address                      String?
  caution                      String?
  detail                       String?
  emails                       Json?
  extraFields                  Json?
  phone                        String?
  outlookSendLogs              OutlookSendLog[]
  storedDocuments              StoredDocument[]

  @@index([name])
}

model StoredDocument {
  id         String             @id @default(cuid())
  siteId     String?
  partnerId  String?
  kind       StoredDocumentKind
  subject    String?
  tags       Json?
  fileName   String
  mimeType   String
  sizeBytes  Int
  storedPath String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  bizDateYmd String?
  partner    Partner?           @relation(fields: [partnerId], references: [id])
  site       Site?              @relation(fields: [siteId], references: [id])

  @@index([siteId, createdAt])
  @@index([partnerId, createdAt])
  @@index([kind, createdAt])
  @@index([kind, bizDateYmd])
}

model OutlookSendLog {
  id        String            @id @default(cuid())
  siteId    String
  partnerId String
  kind      OutlookMailKind
  status    OutlookMailStatus
  toEmail   String
  subject   String
  error     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  partner   Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  site      Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
  @@index([siteId, createdAt])
  @@index([createdAt])
}

enum IntegrationProvider {
  JDL
}

enum IntegrationStatus {
  ACTIVE
  DISABLED
}

enum AccountingType {
  EXPENSE
  LABOR
  ACCOUNTS_RECEIVABLE
}

enum OutlookMailKind {
  REPORT
  INVOICE
}

enum StoredDocumentKind {
  REPORT
  INVOICE
  BUSINESS_CARD
  PHOTO
}

enum OutlookMailStatus {
  SENT
  FAILED
}

enum WorkEntryKind {
  NORMAL
  DAILY
}

enum SiteKind {
  NORMAL
  DAILY
}

enum UserKind {
  NORMAL
  DAILY
}
