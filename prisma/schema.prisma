generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum IntegrationProvider {
  JDL
}

enum IntegrationStatus {
  ACTIVE
  DISABLED
}

enum AccountingType {
  EXPENSE
  LABOR
  ACCOUNTS_RECEIVABLE
}

enum OutlookMailKind {
  REPORT
  INVOICE
}

enum StoredDocumentKind {
  REPORT
  INVOICE
  BUSINESS_CARD
  PHOTO
}

enum OutlookMailStatus {
  SENT
  FAILED
}

enum WorkEntryKind {
  NORMAL
  DAILY
}

enum SiteKind {
  NORMAL
  DAILY
}

enum UserKind {
  NORMAL
  DAILY
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String?
  kind      UserKind @default(NORMAL)

  // Per-user schedule edit permission (granted from admin UI)
  canEditSchedule Boolean @default(false)

  // Whether the user can grant schedule edit permission to others.
  canGrantScheduleEdit Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calendarEvents CalendarEvent[]
  workEntries    WorkEntry[]
  integrations   IntegrationAccount[]
  loginMemories  UserLoginMemory[]
  uiSettings     UserUiSetting[]
  targetScheduleChanges ScheduleChangeHistory[] @relation("TargetUserScheduleChangeHistory")
  editorScheduleChanges ScheduleChangeHistory[] @relation("EditorUserScheduleChangeHistory")

  siteMemberships SiteMember[]
  timeClocks      TimeClock[]
}

model UserLoginMemory {
  id              String   @id @default(cuid())
  userId          String
  fingerprintHash String   @unique
  ipHash          String?
  userAgentHash   String?
  host            String   @default("")
  platform        String   @default("")
  language        String   @default("")
  timeZone        String   @default("")
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleChangeHistories ScheduleChangeHistory[]

  @@index([userId, lastSeenAt])
}

model ScheduleChangeHistory {
  id                String   @id @default(cuid())
  kind              WorkEntryKind @default(NORMAL)
  targetUserId      String
  editorUserId      String?
  editorLoginMemoryId String?
  dayYmd            String
  targetUserLabel   String   @default("")
  projectLabel      String   @default("")
  targetLabel       String   @default("")
  beforeValue       String   @default("")
  afterValue        String   @default("")
  editorLabel       String   @default("")
  editorIpHash      String?
  editorUserAgentHash String?
  editorHost        String   @default("")
  editorPlatform    String   @default("")
  editorLanguage    String   @default("")
  editorTimeZone    String   @default("")
  createdAt         DateTime @default(now())

  targetUser User @relation("TargetUserScheduleChangeHistory", fields: [targetUserId], references: [id], onDelete: Cascade)
  editorUser User? @relation("EditorUserScheduleChangeHistory", fields: [editorUserId], references: [id], onDelete: SetNull)
  editorLoginMemory UserLoginMemory? @relation(fields: [editorLoginMemoryId], references: [id], onDelete: SetNull)

  @@index([kind, createdAt])
  @@index([dayYmd, createdAt])
  @@index([targetUserId, dayYmd, createdAt])
  @@index([editorUserId, createdAt])
}

model UserUiSetting {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, key])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  title       String
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean  @default(false)
  description String?
  location    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
}

model WorkEntry {
  id             String    @id @default(cuid())
  userId         String
  startAt        DateTime
  endAt          DateTime?
  note           String?
  relatedEventId String?

  kind WorkEntryKind @default(NORMAL)

  // Site (genba) ledger relation (optional)
  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  // Accounting (generic; provider-specific mapping happens in provider)
  amount         Decimal?
  taxCategory    String?
  summary        String?
  department     String?
  accountingType AccountingType?
  accountingMeta Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
  @@index([siteId, startAt])
}

model Site {
  id          String   @id @default(cuid())
  companyName String?
  name        String
  kind        SiteKind @default(NORMAL)
  address     String?
  phone       String?
  contactName String?
  notes       String?

  // Site detail fields (for ledger detail screen)
  pace        String?
  amount      Decimal?
  detail      String?
  peopleCount Int?
  caution     String?

  // Schedule label default color (used for Week/Month schedule rendering)
  scheduleLabelColor String @default("default")

  // Default work duration in minutes (used as a suggestion on stamping/manual entry)
  defaultWorkMinutes Int?

  // Monthly depreciation count threshold (alert when entries >= threshold)
  depreciationThreshold Int @default(10)

  // Per-site alert switch (used to suppress unintended alerts)
  alertsEnabled Boolean @default(true)

  // Repeat rule (pace) stored as JSON (intervalMonths, weekdays, monthDays)
  repeatRule Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workEntries     WorkEntry[]
  outlookSendLogs OutlookSendLog[]
  storedDocuments StoredDocument[]

  members SiteMember[]
  timeClocks TimeClock[]

  @@index([name])
  @@index([companyName, name])
}

model SiteMember {
  id        String   @id @default(cuid())
  siteId    String
  userId    String
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, userId])
  @@index([siteId])
  @@index([userId])
}

model TimeClock {
  id        String   @id @default(cuid())
  userId    String
  siteId    String?
  inAt      DateTime
  outAt     DateTime?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([userId, inAt])
  @@index([siteId, inAt])
  @@index([userId, outAt])
}

model IntegrationAccount {
  id          String              @id @default(cuid())
  userId      String
  provider    IntegrationProvider
  status      IntegrationStatus   @default(ACTIVE)
  displayName String?
  credentials Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
}

model AccountingExportPreset {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String?
  // Body object for POST /api/accounting/export and /api/accounting/query
  body      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Partner {
  id     String  @id @default(cuid())
  name   String  @unique
  email  String?
  emails Json?
  notes  String?

  address     String?
  phone       String?
  fax         String?
  detail      String?
  caution     String?
  extraFields Json?

  outlookToEmailDefault        String?
  outlookSubjectReportDefault  String?
  outlookSubjectInvoiceDefault String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  outlookSendLogs   OutlookSendLog[]
  storedDocuments   StoredDocument[]

  @@index([name])
}

model StoredDocument {
  id        String             @id @default(cuid())
  siteId    String?
  partnerId String?
  kind      StoredDocumentKind
  subject   String?

  // Business date key (YYYY-MM-DD) for day-based foldering/searching (mainly photos)
  bizDateYmd String?

  // Optional tags for searching / labeling (e.g. photo keywords)
  tags Json?

  // Original attachment name shown to users
  fileName  String
  mimeType  String
  sizeBytes Int

  // Absolute or workspace-relative path to the stored file (server-side)
  storedPath String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site    Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
  @@index([partnerId, createdAt])
  @@index([kind, createdAt])
  @@index([kind, bizDateYmd])
}

model OutlookSendLog {
  id        String            @id @default(cuid())
  siteId    String
  partnerId String
  kind      OutlookMailKind
  status    OutlookMailStatus
  toEmail   String
  subject   String
  error     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
  @@index([siteId, createdAt])
  @@index([createdAt])
}
