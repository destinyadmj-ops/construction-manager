# Production Tuning Parameters - Copy to /home/linuxuser/.bitget_env and adjust

# === Core Mode ===
DRY_RUN=false
ENABLE_PHASE45=true
ENABLE_DOTEN=true
DOTEN_KEEP_BOTH_ENABLED=true
MONITOR_AUTOPOLL_ENABLED=true
MONITOR_AUTOPOLL_INTERVAL_SECONDS=20
MONITOR_SCHEDULER_LEASE_SECONDS=45
MONITOR_MIN_INTERVAL_SECONDS=8
MONITOR_RUN_TIMEOUT_SECONDS=25
MONITOR_DEFAULT_ALERT_PROFILE=alert_d
MONITOR_SYMBOL_PROFILE_MAP=BTCUSDT:alert_b,ETHUSDT:alert_b,SOLUSDT:alert_b,XRPUSDT:alert_b,DOGEUSDT:alert_d,POLYXUSDT:alert_d,SIRENUSDT:alert_d,RIVERUSDT:alert_d,HYPEUSDT:alert_d,PEPEUSDT:alert_d,SHIBUSDT:alert_d,TSLAUSDT:alert_c,ENJUSDT:alert_c
ENABLE_ORDERBLOCK=true

# === Learning & Weight Rebalance ===
# Learning weight rebalance cycle: how aggressive to shift weight based on recent win_rate/roi
# Higher = faster adaptation to recent performance
LEARNING_REBALANCE_SPEED=1.0

# Win-rate decay: older trades lose influence over time (0.0-1.0, 1.0=no decay)
LEARNING_DECAY_FACTOR=0.95

# Minimum closed trades before alert is considered "trained"
LEARNING_MIN_SAMPLES=3

# === Entry Filters ===
# Minimum ATR ratio to allow entry (below this = low volatility, skip entry)
MIN_ENTRY_ATR_RATIO=0.0007

# ドテン（reversals）only allowed when bot_eval score >= this threshold
DOTEN_MIN_SCORE=0.55

# ドテン（reversals）only allowed when bot_eval confidence >= this threshold
DOTEN_MIN_CONFIDENCE=0.75

# Global size scale multiplier (applied after strategy size multiplier)
ORDER_SIZE_SCALE=1.00

# Base order notional as a fraction of current account balance (0.10 = 10%).
BASE_ORDER_BALANCE_PCT=0.10
MIN_ENTRY_BALANCE_PCT=0.10

# Minimum estimated order notional in USDT. Block entries smaller than this.
MIN_ORDER_NOTIONAL_USDT=6.0

# Minimum spacing between exchange order API calls across workers.
ORDER_API_MIN_INTERVAL_MS=900

# Extra spacing before re-open during doten (close -> open).
DOTEN_REOPEN_DELAY_MS=1200

# After Bitget 429, block new order requests for this cooldown window.
EXCHANGE_429_COOLDOWN_SECONDS=20

# Position manager runtime controls
