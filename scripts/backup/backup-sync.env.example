# Copy /opt/master-hub/backups to an external object store.

# Option A: use an existing rclone remote.
# Example target: s3-archive:masterhub/prod
# BACKUP_SYNC_TARGET="remote-name:masterhub/prod"

# Option B: define a Cloudflare R2 remote from env only.
BACKUP_SYNC_PROVIDER="r2"
BACKUP_SYNC_REMOTE_NAME="backupsync"
BACKUP_SYNC_BUCKET="masterhub-backups"
BACKUP_SYNC_PREFIX="prod"
BACKUP_SYNC_ACCESS_KEY_ID="replace-me"
BACKUP_SYNC_SECRET_ACCESS_KEY="replace-me"
BACKUP_SYNC_REGION="auto"
BACKUP_SYNC_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
BACKUP_SYNC_NO_CHECK_BUCKET="true"

# Option C: AWS S3 example.
# BACKUP_SYNC_PROVIDER="s3"
# BACKUP_SYNC_REMOTE_NAME="backupsync"
# BACKUP_SYNC_BUCKET="masterhub-backups"
# BACKUP_SYNC_PREFIX="prod"
# BACKUP_SYNC_ACCESS_KEY_ID="AKIA..."
# BACKUP_SYNC_SECRET_ACCESS_KEY="replace-me"
# BACKUP_SYNC_REGION="ap-northeast-1"
# BACKUP_SYNC_STORAGE_CLASS="STANDARD_IA"
# BACKUP_SYNC_SERVER_SIDE_ENCRYPTION="AES256"

# Optional overrides
# BACKUP_SYNC_SOURCE="/opt/master-hub/backups"
# RCLONE_CONFIG_FILE="/home/linuxuser/.config/rclone/rclone.conf"
# BACKUP_SYNC_DELETE_OLDER_THAN="90d"
# BACKUP_SYNC_BWLIMIT="8M"
# BACKUP_SYNC_SESSION_TOKEN="replace-me-if-using-sts"
# BACKUP_SYNC_SSE_KMS_KEY_ID="arn:aws:kms:ap-northeast-1:123456789012:key/xxxx"
# BACKUP_SYNC_ENV_AUTH="true"