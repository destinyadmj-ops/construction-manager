# Copy /opt/master-hub/backups to an rclone remote.
# Example target: s3-archive:masterhub/prod
BACKUP_SYNC_TARGET="remote-name:masterhub/prod"

# Optional overrides
# BACKUP_SYNC_SOURCE="/opt/master-hub/backups"
# RCLONE_CONFIG_FILE="/home/linuxuser/.config/rclone/rclone.conf"
# BACKUP_SYNC_DELETE_OLDER_THAN="90d"
# BACKUP_SYNC_BWLIMIT="8M"