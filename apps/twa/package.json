{
  "name": "master-hub-twa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "init": "bubblewrap init --manifest=http://localhost:3000/manifest.webmanifest --directory=android",
    "build": "bubblewrap build --directory=android",
    "install": "bubblewrap install --directory=android",
    "open": "start .\\android",
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (Test-Path .\\android) { Remove-Item -Recurse -Force .\\android }\""
  },
  "devDependencies": {
    "@bubblewrap/cli": "1.24.1",
    "node-pty": "^1.1.0"
  }
}
