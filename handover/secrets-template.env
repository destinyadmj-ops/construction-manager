# ===== Vultr / Cloudflare / Trading Bot Secrets Template =====
# 使い方:
# - 値を設定して `.env` として保存
# - このファイル自体は Git にコミットしない
# - 本番値は 1Password / Bitwarden / Vault 等で共有

# --- Environment ---
BOT_ENV=production
APP_PORT=8000
TZ=Asia/Tokyo

# --- Vultr ---
VULTR_API_KEY=
VULTR_INSTANCE_ID=
VULTR_REGION=

# --- Cloudflare ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DNS_RECORD_ID=

# --- Exchange / Broker ---
EXCHANGE_NAME=bitget
EXCHANGE_API_KEY=bg_036ebeed7c6e4080b5b2b38384cfe6b4
EXCHANGE_API_SECRET=39cf223bc7a663faff7b73c2372b1483701aa6c33a7b0aad1a8007c11b12e4f4
EXCHANGE_PASSPHRASE=TVauto1destiny9888

# --- Database ---
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- App Security ---
JWT_SECRET=
ENCRYPTION_KEY=
WEBHOOK_SECRET=

# --- Notifications (optional) ---
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Runtime Flags ---
DRY_RUN=true
LOG_LEVEL=info
MAX_POSITION_SIZE=
RISK_LIMIT_PCT=
